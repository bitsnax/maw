// MAW — Managed Agent Wrapper
//
// Better Auth tables (user, session, account, verification), then MAW's
// own models. Every change here ships with its migration in the same commit.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  firstname     String?
  lastname      String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  emailVerified Boolean   @default(false)
  image         String?
  banned        Boolean?  @default(false)
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  machinesCreated Machine[]       @relation("MachineCreatedBy")
  machineActions  MachineAction[]
  projectsCreated Project[]       @relation("ProjectCreatedBy")
  projectSessions ProjectSession[]
  projectCommands ProjectCommand[] @relation("ProjectCommandCreatedBy")
  commandRuns     CommandRun[]
  storiesCreated  Story[]          @relation("StoryCreatedBy")

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Machines (Phase 1): MAW's certificate authority, paired machines, and the
// record of every action sent to a machine.
// ---------------------------------------------------------------------------

// One row (id "maw"): MAW's certificate authority and MAW's own client
// certificate. Private keys are encrypted with MAW_ENCRYPTION_KEY (lib/crypto.ts).
model Pki {
  id            String   @id @default("maw")
  caCertPem     String
  caKeyEnc      String
  clientCertPem String
  clientKeyEnc  String
  createdAt     DateTime @default(now())

  @@map("pki")
}

// A paired machine running maw-agent. MAW trusts the agent only if its
// certificate chains to MAW's CA AND its SHA-256 fingerprint equals
// certFingerprint. The agent's private key is never stored.
model Machine {
  id              String          @id @default(cuid())
  name            String          @unique
  address         String
  port            Int             @default(7017)
  runAs           String
  certFingerprint String
  certNotAfter    DateTime
  createdById     String?
  createdBy       User?           @relation("MachineCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  lastSeenAt      DateTime?
  agentVersion    String?
  hostname        String?
  actions         MachineAction[]
  projects        Project[]

  @@map("machine")
}

// Who did what to which machine, and how it went. Kept when the machine or
// the user is removed (machineName keeps the record readable).
model MachineAction {
  id          String   @id @default(cuid())
  machineId   String?
  machine     Machine? @relation(fields: [machineId], references: [id], onDelete: SetNull)
  machineName String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action      String
  target      String?
  ok          Boolean
  message     String?
  createdAt   DateTime @default(now())

  @@index([machineId, createdAt])
  @@index([userId])
  @@map("machine_action")
}

// ---------------------------------------------------------------------------
// Projects (Phase 3): a folder on a paired machine that OpenCode sessions
// work in. `slug` names the project's workspace folder in maw-opencode
// (/workspaces/<slug>); it never changes once set. A machine with projects
// cannot be removed (Restrict): remove its projects first.
// ---------------------------------------------------------------------------

model Project {
  id          String           @id @default(cuid())
  name        String           @unique
  slug        String           @unique
  machineId   String
  machine     Machine          @relation(fields: [machineId], references: [id], onDelete: Restrict)
  root        String
  createdById String?
  createdBy   User?            @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  sessions    ProjectSession[]
  commands    ProjectCommand[]
  commandRuns CommandRun[]
  stories     Story[]
  // Project profile, kept in MAW: facts every story session is given,
  // verifyCommands run in order after each step, protectedBranches are never
  // worked on.
  profile           String   @default("")
  verifyCommands    String[] @default([])
  protectedBranches String[] @default([])

  @@unique([machineId, root])
  @@map("project")
}

// One OpenCode session in a project. `id` is OpenCode's own session id; the
// messages live in OpenCode (maw-opencode's volume), MAW keeps who started it
// and when. Removing a project removes its rows (and MAW deletes the
// sessions in OpenCode too).
model ProjectSession {
  id        String   @id
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, createdAt])
  @@map("project_session")
}

// A button on a project's pages that runs one command in the project folder
// on its machine (git branch, commit, push, …). The person owns these; the
// model never runs them. `{name}` placeholders are asked for (or filled from
// the page) when the button is pressed. Removing a project removes its
// buttons.
model ProjectCommand {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  command     String
  position    Int
  createdById String?
  createdBy   User?    @relation("ProjectCommandCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, position])
  @@map("project_command")
}

// One press of a project command button, shown in the Dashboard's output
// window among the session's messages (never sent to OpenCode). `sessionId`
// is the OpenCode session that was open, `storyId` the story (null: none);
// `lines` is the output
// once the command has ended (the last 500 lines, [{s:"o"|"e", t}]).
model CommandRun {
  id         String    @id @default(cuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessionId  String?
  storyId    String?
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title      String
  command    String
  machineId  String
  jobId      String
  state      String    @default("running")
  exitCode   Int?
  durationMs Int?
  lines      Json?
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  @@index([projectId, sessionId, startedAt])
  @@map("command_run")
}

// A story: work too big for one model session (65,536 tokens), carried
// through in small ones. MAW's agent breaks the story into phases and each
// phase into steps; every planning pass and every step is its own session.
// The database is the record; nothing is written into the project for it.
//   Story ─ Phase ─ Step
// Checklist items (questions the planning sessions answer, each checked in
// its own pass) and their findings belong to the story (phaseId null) or to
// one phase.
model Story {
  id          String         @id @default(cuid())
  projectId   String
  project     Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number      Int
  title       String
  request     String
  // planning, phases-ready, in-progress, paused, blocked, done
  status      String         @default("planning")
  // where Resume / Retry returns a paused or blocked story (planning or in-progress)
  resumeTo    String?
  // why the runner is waiting before the next step (wrong or protected branch), or ""
  runnerNote  String         @default("")
  branch      String?
  // the story plan: what the phases add up to
  overview    String         @default("")
  outOfScope  String         @default("")
  notes       String         @default("")
  createdById String?
  createdBy   User?          @relation("StoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  phases      StoryPhase[]
  items       StoryItem[]
  findings    StoryFinding[]
  jobs        StoryJob[]

  @@unique([projectId, number])
  @@map("story")
}

// One phase of a story: a coherent part that is planned into steps on its
// own (its own checklist and findings), then worked step by step.
// status: pending, planning, steps-ready, in-progress, blocked, done
model StoryPhase {
  id        String         @id @default(cuid())
  storyId   String
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  number    Int
  title     String
  goal      String         @default("")
  approach  String         @default("")
  notes     String         @default("")
  status    String         @default("pending")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  steps     StoryStep[]
  items     StoryItem[]
  findings  StoryFinding[]
  jobs      StoryJob[]

  @@unique([storyId, number])
  @@map("story_phase")
}

// One step of a phase: everything a fresh session needs to carry it out.
// status: pending, in-progress, done, blocked
model StoryStep {
  id           String     @id @default(cuid())
  phaseId      String
  phase        StoryPhase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  number       Int
  title        String
  files        String     @default("")
  check        Boolean    @default(false)
  status       String     @default("pending")
  goal         String     @default("")
  readBudget   String     @default("")
  context      String     @default("")
  changes      String     @default("")
  verification String     @default("")
  manualCheck  String     @default("")
  result       String     @default("")
  verifyOutput String     @default("")
  // git status and git diff of the project after the step (uncommitted changes)
  diff         String     @default("")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  jobs         StoryJob[]

  @@unique([phaseId, number])
  @@map("story_step")
}

// A checklist item of a planning pass: a question the plan needs answered,
// checked in its own session. `developer` marks one only you can answer.
model StoryItem {
  id        String         @id @default(cuid())
  storyId   String
  story     Story          @relation(fields: [storyId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     StoryPhase?    @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  position  Int
  text      String
  checked   Boolean        @default(false)
  developer Boolean        @default(false)
  answer    String?
  checkedAt DateTime?
  createdAt DateTime       @default(now())
  findings  StoryFinding[]
  jobs      StoryJob[]

  @@index([storyId, phaseId, position])
  @@map("story_item")
}

// What a planning session found, recorded as it went: exact shapes copied
// from source, which later sessions rely on instead of reading again.
model StoryFinding {
  id        String      @id @default(cuid())
  storyId   String
  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     StoryPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  itemId    String?
  item      StoryItem?  @relation(fields: [itemId], references: [id], onDelete: SetNull)
  position  Int
  heading   String      @default("")
  body      String
  createdAt DateTime    @default(now())

  @@index([storyId, phaseId, position])
  @@map("story_finding")
}

// One model session MAW runs for a story: what it works on and how it went.
// The story tools find their target through the session id.
// kind: story-checklist  write the story's checklist
//       story-item       answer one story checklist item
//       story-phases     write the story plan and its phases
//       phase-checklist  write one phase's checklist
//       phase-item       answer one phase checklist item
//       phase-steps      write one phase's plan and steps
//       step             carry out one step
// state: running, done, failed, stopped
model StoryJob {
  id        String      @id @default(cuid())
  storyId   String
  story     Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  phaseId   String?
  phase     StoryPhase? @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  stepId    String?
  step      StoryStep?  @relation(fields: [stepId], references: [id], onDelete: Cascade)
  itemId    String?
  item      StoryItem?  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind      String
  sessionId String      @unique
  state     String      @default("running")
  note      String      @default("")
  createdAt DateTime    @default(now())
  endedAt   DateTime?

  @@index([storyId, createdAt])
  @@map("story_job")
}
