# Copy to .env and fill in (maw-transform.sh writes .env with generated
# secrets). .env is gitignored; this template is committed.

# --- Postgres (compose service) ---
# Use letters and digits only: the password is placed in DATABASE_URL
# without URL-encoding.
POSTGRES_USER=maw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maw
# Host port for loopback-only access (127.0.0.1). Optional.
MAW_DB_HOST_PORT=5434

# For host-side Prisma commands run from web/ (container DATABASE_URL is
# built in docker-compose.yml from the values above).
DATABASE_URL=postgresql://maw:change-me@127.0.0.1:5434/maw?schema=public

# --- Better Auth ---
BETTER_AUTH_URL=https://maw.lan.arpa
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
