# Copy to .env and fill in (maw-transform.sh writes .env with generated
# secrets). .env is gitignored; this template is committed.

# --- Postgres (compose service) ---
# Use letters and digits only: the password is placed in DATABASE_URL
# without URL-encoding.
POSTGRES_USER=maw
POSTGRES_PASSWORD=change-me
POSTGRES_DB=maw
# Host port for loopback-only access (127.0.0.1). Optional.
MAW_DB_HOST_PORT=5434

# For host-side Prisma commands run from web/ (container DATABASE_URL is
# built in docker-compose.yml from the values above).
DATABASE_URL=postgresql://maw:change-me@127.0.0.1:5434/maw?schema=public

# --- Secrets at rest (web/lib/crypto.ts) ---
# AES-256-GCM key for secrets MAW stores (its certificate authority's key).
# openssl rand -base64 32. NEVER rotate once a machine is paired: the stored
# key becomes unreadable and every machine must be paired again.
MAW_ENCRYPTION_KEY=change-me

# --- Better Auth ---
BETTER_AUTH_URL=https://maw.lan.arpa
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me

# --- OpenCode's tools (Phase 3) ---
# Shared by maw-web and maw-opencode: the tools call /api/tools/* with it.
# openssl rand -hex 32 (at least 32 characters). phase3-02.sh adds it.
MAW_TOOLS_TOKEN=change-me-to-64-hex-characters-from-openssl-rand-hex-32-xxxxxxxx

# --- maw-opencode (Phase 3) ---
# maw-web signs in to OpenCode with it (basic auth). openssl rand -hex 24.
MAW_OPENCODE_PASSWORD=change-me
# llama.cpp's API key on the GPU box (the llama-cpp container's LLAMA_API_KEY).
# phase3-03.sh copies it; update it here and recreate maw-opencode if it changes.
LLAMACPP_API_KEY=change-me
# Optional (defaults shown):
# LLAMACPP_BASE_URL=http://192.168.4.201:8081/v1
# LLAMACPP_MODEL=Qwen3.8-27B-GSQ-RCO-IQ3_S-mtp
